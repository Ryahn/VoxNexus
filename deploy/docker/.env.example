# Copy to `.env` in this directory (or pass `--env-file`). Values below are for local Compose only.

POSTGRES_USER=voxnexus
POSTGRES_PASSWORD=voxnexus
POSTGRES_DB=voxnexus

# Host-facing origin (browser). Inside the network the app uses service DNS names.
PUBLIC_URL=http://127.0.0.1:8080

S3_ACCESS_KEY=voxnexus
S3_SECRET_KEY=voxnexus-s3-dev-secret
S3_BUCKET=voxnexus

TYPESENSE_API_KEY=voxnexus-typesense-dev

# Optional toggles for the app container
COOKIE_SECURE=false
LOG_LEVEL=info
GATEWAY_ALLOW_UNAUTH=false
METRICS_ENABLED=false

# --- Authentik overlay (compose.authentik.yml) ---
# Required when using the overlay. Use 50+ random characters in real use.
AUTHENTIK_SECRET_KEY=change-me-authentik-secret-key-use-50-plus-random-chars
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-authentik-admin

# --- OIDC (Compose app reads these; root config.toml is NOT used by the container) ---
# After creating an OAuth2/OpenID provider in Authentik, uncomment and fill.
# For Compose app, use 127.0.0.1 issuer + OIDC_OUTBOUND_HOST=host.docker.internal
# (server dials Docker's host gateway; browser stays on 127.0.0.1):
# OIDC_ISSUER=http://127.0.0.1:9000/application/o/voxnexus/
# OIDC_OUTBOUND_HOST=host.docker.internal
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ONLY=false
# OIDC_LINK_BY_EMAIL=true
