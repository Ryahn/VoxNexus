{
  "openapi": "3.1.0",
  "info": {
    "title": "VoxNexus HTTP API",
    "description": "Versioned HTTP API for a VoxNexus instance. Probe routes `/health`, `/ready`, and `/metrics` are not part of this document.",
    "license": {
      "name": "LicenseRef-VoxNexus-Source-Available",
      "identifier": "LicenseRef-VoxNexus-Source-Available"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log in with email and password.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Logged in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Clear the session cookie and delete the server session.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Logged out"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Current account for the session cookie.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "Current account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me/email": {
      "patch": {
        "tags": [
          "auth"
        ],
        "summary": "Change email (re-auth; applied immediately until F117 adds confirmation mail).",
        "operationId": "changeMyEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeEmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Email updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Wrong current password or not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Email taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me/password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Change password (re-auth with current password).",
        "operationId": "changeMyPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Password updated"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Wrong current password or not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/oidc/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "OIDC provider callback: exchange code, resolve account, set session cookie, redirect home.",
        "operationId": "oidcCallback",
        "responses": {
          "302": {
            "description": "Redirect to SPA with session cookie or login error"
          },
          "400": {
            "description": "Invalid callback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "OIDC not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/oidc/start": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Redirect the browser to the configured OIDC provider (authorization code + PKCE).",
        "operationId": "startOidcLogin",
        "responses": {
          "302": {
            "description": "Redirect to OIDC provider"
          },
          "404": {
            "description": "OIDC not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register a local account and set the session cookie.",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Registration closed or CSRF",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Email taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/communities": {
      "post": {
        "tags": [
          "communities"
        ],
        "summary": "Policy check for user-driven community creation (F017 stub; F019 persists communities).",
        "operationId": "createCommunity",
        "responses": {
          "202": {
            "description": "Creation allowed (stub)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunityCreateAcceptedResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Creation disallowed by instance policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/instance/settings": {
      "get": {
        "tags": [
          "instance"
        ],
        "summary": "Read instance settings (instance admin only).",
        "operationId": "getInstanceSettings",
        "responses": {
          "200": {
            "description": "Instance settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceSettingsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Not instance admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "instance"
        ],
        "summary": "Update instance settings (instance admin only).",
        "operationId": "updateInstanceSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateInstanceSettingsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated instance settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceSettingsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Not instance admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/profile": {
      "get": {
        "tags": [
          "profiles"
        ],
        "summary": "Current user's profile.",
        "operationId": "getMyProfile",
        "responses": {
          "200": {
            "description": "Own profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "profiles"
        ],
        "summary": "Update display name and/or bio.",
        "operationId": "updateMyProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/profile/avatar": {
      "post": {
        "tags": [
          "profiles"
        ],
        "summary": "Upload avatar image (raw body; Content-Type ignored in favor of magic bytes).",
        "operationId": "uploadMyAvatar",
        "requestBody": {
          "content": {
            "application/octet-stream": {}
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or oversized image",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/profile/banner": {
      "post": {
        "tags": [
          "profiles"
        ],
        "summary": "Upload banner image.",
        "operationId": "uploadMyBanner",
        "requestBody": {
          "content": {
            "application/octet-stream": {}
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or oversized image",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Instance name, version, and public policy flags.",
        "operationId": "getMeta",
        "responses": {
          "200": {
            "description": "Instance name and version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/presence": {
      "get": {
        "tags": [
          "presence"
        ],
        "summary": "List accounts currently online on this instance (invisible omitted).",
        "operationId": "listPresence",
        "responses": {
          "200": {
            "description": "Online accounts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresenceListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profiles/{account_id}": {
      "get": {
        "tags": [
          "profiles"
        ],
        "summary": "Read another account's profile (authenticated).",
        "operationId": "getProfile",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "description": "Account id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profiles/{account_id}/avatar": {
      "get": {
        "tags": [
          "profiles"
        ],
        "summary": "Stream an account's avatar (authenticated).",
        "operationId": "getProfileAvatar",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "description": "Account id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Image bytes"
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/profiles/{account_id}/banner": {
      "get": {
        "tags": [
          "profiles"
        ],
        "summary": "Stream an account's banner (authenticated).",
        "operationId": "getProfileBanner",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "description": "Account id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Image bytes"
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountResponse": {
        "type": "object",
        "description": "Public account fields (never includes password hash).",
        "required": [
          "id",
          "is_bot",
          "is_instance_admin"
        ],
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_bot": {
            "type": "boolean"
          },
          "is_instance_admin": {
            "type": "boolean"
          }
        }
      },
      "AuthSessionResponse": {
        "type": "object",
        "description": "Authenticated session payload.",
        "required": [
          "account"
        ],
        "properties": {
          "account": {
            "$ref": "#/components/schemas/AccountResponse"
          }
        }
      },
      "ChangeEmailRequest": {
        "type": "object",
        "description": "Change email (requires current password; applied immediately until F117 adds confirmation mail).",
        "required": [
          "email",
          "current_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "description": "Change password (requires current password).",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          },
          "revoke_other_sessions": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "When true, delete all other sessions for this account (current session stays)."
          }
        }
      },
      "CommunityCreateAcceptedResponse": {
        "type": "object",
        "description": "Stub acceptance body until F019 implements community persistence.",
        "required": [
          "accepted"
        ],
        "properties": {
          "accepted": {
            "type": "boolean"
          }
        }
      },
      "CommunityCreationMode": {
        "type": "string",
        "description": "Who may create communities on this instance.",
        "enum": [
          "open",
          "admin_only",
          "single"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "description": "JSON error envelope for `/api/v1` and unknown routes.",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "type": [
              "object",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "InstanceSettingsResponse": {
        "type": "object",
        "description": "Instance settings visible to instance admins.",
        "required": [
          "id",
          "name",
          "public_url",
          "registration_mode",
          "community_creation_mode",
          "community_creation_mode_locked",
          "oidc_enabled",
          "updated_at"
        ],
        "properties": {
          "community_creation_mode": {
            "$ref": "#/components/schemas/CommunityCreationMode"
          },
          "community_creation_mode_locked": {
            "type": "boolean",
            "description": "When true, [`UpdateInstanceSettingsRequest::community_creation_mode`] is ignored."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "oidc_client_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "oidc_enabled": {
            "type": "boolean"
          },
          "oidc_issuer": {
            "type": [
              "string",
              "null"
            ]
          },
          "public_url": {
            "type": "string"
          },
          "registration_mode": {
            "$ref": "#/components/schemas/RegistrationMode"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "Login with email and password.",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MetaResponse": {
        "type": "object",
        "description": "Build, version, and public instance policy flags for the SPA.",
        "required": [
          "name",
          "version",
          "registration_mode",
          "community_creation_mode",
          "oidc_enabled",
          "password_login_enabled"
        ],
        "properties": {
          "community_creation_mode": {
            "$ref": "#/components/schemas/CommunityCreationMode"
          },
          "name": {
            "type": "string"
          },
          "oidc_enabled": {
            "type": "boolean",
            "description": "Whether SSO sign-in is configured and enabled for this instance."
          },
          "password_login_enabled": {
