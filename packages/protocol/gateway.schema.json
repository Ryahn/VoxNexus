{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GatewaySchemaCatalog",
  "description": "Schema catalog for TypeScript codegen (`schemars` → `packages/protocol`).",
  "type": "object",
  "required": [
    "community_role_payload",
    "dev_ping_payload",
    "dev_pong_payload",
    "envelope",
    "event_scope",
    "event_type",
    "heartbeat_ack_payload",
    "heartbeat_payload",
    "hello_payload",
    "identify_payload",
    "invalid_session_payload",
    "member_join_payload",
    "member_leave_payload",
    "member_role_update_payload",
    "presence_sync_payload",
    "presence_update_payload",
    "ready_payload",
    "resume_payload",
    "resumed_payload",
    "role_delete_payload",
    "status_update_payload"
  ],
  "properties": {
    "community_role_payload": {
      "$ref": "#/definitions/CommunityRolePayload"
    },
    "dev_ping_payload": {
      "$ref": "#/definitions/DevPingPayload"
    },
    "dev_pong_payload": {
      "$ref": "#/definitions/DevPongPayload"
    },
    "envelope": {
      "$ref": "#/definitions/Envelope"
    },
    "event_scope": {
      "$ref": "#/definitions/EventScope"
    },
    "event_type": {
      "$ref": "#/definitions/EventType"
    },
    "heartbeat_ack_payload": {
      "$ref": "#/definitions/HeartbeatAckPayload"
    },
    "heartbeat_payload": {
      "$ref": "#/definitions/HeartbeatPayload"
    },
    "hello_payload": {
      "$ref": "#/definitions/HelloPayload"
    },
    "identify_payload": {
      "$ref": "#/definitions/IdentifyPayload"
    },
    "invalid_session_payload": {
      "$ref": "#/definitions/InvalidSessionPayload"
    },
    "member_join_payload": {
      "$ref": "#/definitions/MemberJoinPayload"
    },
    "member_leave_payload": {
      "$ref": "#/definitions/MemberLeavePayload"
    },
    "member_role_update_payload": {
      "$ref": "#/definitions/MemberRoleUpdatePayload"
    },
    "presence_sync_payload": {
      "$ref": "#/definitions/PresenceSyncPayload"
    },
    "presence_update_payload": {
      "$ref": "#/definitions/PresenceUpdatePayload"
    },
    "ready_payload": {
      "$ref": "#/definitions/ReadyPayload"
    },
    "resume_payload": {
      "$ref": "#/definitions/ResumePayload"
    },
    "resumed_payload": {
      "$ref": "#/definitions/ResumedPayload"
    },
    "role_delete_payload": {
      "$ref": "#/definitions/RoleDeletePayload"
    },
    "status_update_payload": {
      "$ref": "#/definitions/StatusUpdatePayload"
    }
  },
  "definitions": {
    "CommunityRolePayload": {
      "description": "Server → client when a role is created (F028).",
      "type": "object",
      "required": [
        "color",
        "community_id",
        "hoist",
        "id",
        "is_everyone",
        "mentionable",
        "name",
        "permissions",
        "position",
        "role_card",
        "short_tag",
        "weight"
      ],
      "properties": {
        "color": {
          "type": "string"
        },
        "community_id": {
          "type": "string",
          "format": "uuid"
        },
        "gradient": {
          "type": [
            "string",
            "null"
          ]
        },
        "group_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "hoist": {
          "type": "boolean"
        },
        "icon_emoji": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon_object_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "is_everyone": {
          "type": "boolean"
        },
        "mentionable": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "permissions": true,
        "position": {
          "type": "integer",
          "format": "int32"
        },
        "role_card": true,
        "short_tag": {
          "type": "string"
        },
        "weight": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "DevPingPayload": {
      "description": "Dev-only ping (requires `GATEWAY_ALLOW_UNAUTH` after identify).",
      "type": "object",
      "required": [
        "nonce"
      ],
      "properties": {
        "nonce": {
          "type": "string"
        }
      }
    },
    "DevPongPayload": {
      "description": "Reply to [`DevPingPayload`].",
      "type": "object",
      "required": [
        "nonce"
      ],
      "properties": {
        "nonce": {
          "type": "string"
        }
      }
    },
    "Envelope": {
      "description": "Versioned JSON envelope on the gateway WebSocket.",
      "type": "object",
      "required": [
        "event_id",
        "event_type",
        "payload",
        "sequence",
        "timestamp"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_type": {
          "$ref": "#/definitions/EventType"
        },
        "payload": true,
        "scope": {
          "anyOf": [
            {
              "$ref": "#/definitions/EventScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "EventScope": {
      "description": "Subscription / fanout scope (connection-level events omit this).",
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "EventType": {
      "description": "Closed set of gateway `event_type` values.",
      "type": "string",
      "enum": [
        "HELLO",
        "HEARTBEAT",
        "HEARTBEAT_ACK",
        "IDENTIFY",
        "READY",
        "RESUME",
        "RESUMED",
        "INVALID_SESSION",
        "DEV_PING",
        "DEV_PONG",
        "STATUS_UPDATE",
        "PRESENCE_UPDATE",
        "PRESENCE_SYNC",
        "MEMBER_JOIN",
        "MEMBER_LEAVE",
        "ROLE_CREATE",
        "ROLE_UPDATE",
        "ROLE_DELETE",
        "MEMBER_ROLE_UPDATE"
      ]
    },
    "HeartbeatAckPayload": {
      "description": "Server → client heartbeat acknowledgment.",
      "type": "object"
    },
    "HeartbeatPayload": {
      "description": "Client → server heartbeat (empty object).",
      "type": "object"
    },
    "HelloPayload": {
      "description": "`HELLO` payload after WebSocket accept.",
      "type": "object",
      "required": [
        "heartbeat_interval_ms",
        "protocol_version",
        "session_id"
      ],
      "properties": {
        "heartbeat_interval_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "protocol_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "IdentifyPayload": {
      "description": "Client → server identify (HTTP session cookie already bound on the handshake).",
      "type": "object"
    },
    "InvalidSessionPayload": {
      "description": "Server → client when resume cannot continue.",
      "type": "object",
      "required": [
        "resumable"
      ],
      "properties": {
        "resumable": {
          "type": "boolean"
        }
      }
    },
    "MemberJoinPayload": {
      "description": "Server → client when an account joins a community (F020).",
      "type": "object",
      "required": [
        "account_id",
        "community_id",
        "display_name",
        "nickname",
        "role"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "community_id": {
          "type": "string",
          "format": "uuid"
        },
        "display_name": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "MemberLeavePayload": {
      "description": "Server → client when an account leaves a community (F020).",
      "type": "object",
      "required": [
        "account_id",
        "community_id"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "community_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "MemberRoleUpdatePayload": {
      "description": "Server → client when a member's role set changes (F028).",
      "type": "object",
      "required": [
        "account_id",
        "community_id",
        "role_ids"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "community_id": {
          "type": "string",
          "format": "uuid"
        },
        "role_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "PresenceStatus": {
      "description": "Stored preference and gateway-reported status while connected.",
      "type": "string",
      "enum": [
        "online",
        "idle",
        "dnd",
        "invisible"
      ]
    },
    "PresenceSyncPayload": {
      "description": "Server → client bulk presence after identify.",
      "type": "object",
      "required": [
        "presences"
      ],
      "properties": {
        "presences": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PresenceUpdatePayload"
          }
        }
      }
    },
    "PresenceUpdatePayload": {
      "description": "Server → client presence change for one account.",
      "type": "object",
      "required": [
        "account_id",
        "custom_status",
        "status"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "custom_status": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/PublicPresenceStatus"
        }
      }
    },
    "PublicPresenceStatus": {
      "description": "Presence exposed to clients (offline when disconnected or hidden from viewers).",
      "type": "string",
      "enum": [
        "online",
        "idle",
        "dnd",
        "invisible",
        "offline"
      ]
    },
    "ReadyPayload": {
      "description": "Server → client ready after successful identify.",
      "type": "object",
      "required": [
        "account_id",
        "resume_token",
        "session_id"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "format": "uuid"
        },
        "resume_token": {
          "type": "string"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "ResumePayload": {
      "description": "Client → server resume after reconnect.",
      "type": "object",
      "required": [
        "last_sequence",
        "resume_token",
        "session_id"
      ],
      "properties": {
        "last_sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "resume_token": {
          "type": "string"
        },
        "session_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "ResumedPayload": {
      "description": "Server → client after a successful resume (event buffer may still be empty in F013).",
      "type": "object",
      "required": [
        "session_id"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "RoleDeletePayload": {
      "description": "Server → client when a role is deleted (F028).",
      "type": "object",
      "required": [
        "community_id",
        "role_id"
      ],
      "properties": {
        "community_id": {
          "type": "string",
          "format": "uuid"
        },
        "role_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "StatusUpdatePayload": {
      "description": "Client → server presence / custom status change (F018).",
      "type": "object",
      "properties": {
        "custom_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/definitions/PresenceStatus"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
